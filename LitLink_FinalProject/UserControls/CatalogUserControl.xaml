<UserControl x:Class="LitLink_FinalProject.UserControls.CatalogUserControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:LitLink_FinalProject.UserControls"
             mc:Ignorable="d" 
             d:DesignHeight="180" d:DesignWidth="120" Cursor="Hand">

    <Border Background="White" BorderBrush="#FFF0F5" BorderThickness="1" CornerRadius="10" Padding="5" Margin="0,0,10,0" Width="120">
        <StackPanel VerticalAlignment="Center">
            <Border CornerRadius="5" ClipToBounds="True" Height="110" Width="90" HorizontalAlignment="Center">
                <Image x:Name="BookCoverImage" Stretch="UniformToFill"/>
            </Border>
            <TextBlock Text="{Binding bookName}" 
                       FontSize="12" 
                       FontWeight="Bold" 
                       Foreground="#4A4A4A" 
                       HorizontalAlignment="Center" 
                       TextAlignment="Center" 
                       TextTrimming="CharacterEllipsis" 
                       Margin="0,5,0,2"/>
            <TextBlock Text="{Binding price, StringFormat={}{0:C}}" 
                       FontSize="11" 
                       FontWeight="SemiBold" 
                       Foreground="#FF1493" 
                       HorizontalAlignment="Center"/>
        </StackPanel>
    </Border>
</UserControl>