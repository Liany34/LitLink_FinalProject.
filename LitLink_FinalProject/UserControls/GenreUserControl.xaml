<UserControl x:Class="LitLink_FinalProject.UserControls.GenreUserControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:LitLink_FinalProject.UserControls"
             mc:Ignorable="d" 
             d:DesignHeight="220" d:DesignWidth="800" Margin="0,0,0,25">
    <StackPanel>
        <TextBlock x:Name="TxtGenreTitle" Text="Genre Name" FontSize="22" FontWeight="Bold" Foreground="#D06A8D" Margin="5,0,0,10"/>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Button Grid.Column="0" Content="◀" Width="30" Height="40" Background="Transparent" BorderThickness="0" 
                    Foreground="#FF1493" FontSize="16" Cursor="Hand" Click="ScrollLeft_Click" VerticalAlignment="Center"/>

            <ScrollViewer Grid.Column="1" x:Name="BooksScrollViewer" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled">
                <ItemsControl x:Name="GenreBooksItemsControl">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>

                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="White" BorderBrush="#FFF0F5" BorderThickness="1" CornerRadius="10" Padding="8" Margin="0,0,15,5" Width="140">
                                <StackPanel>
                                    <Border CornerRadius="5" ClipToBounds="True" Height="130" Width="100" HorizontalAlignment="Center" Margin="0,0,0,8">
                                        <Image Loaded="BookImage_Loaded" Stretch="UniformToFill" Cursor="Hand" MouseDown="BookImage_MouseDown"/>
                                    </Border>

                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Grid.Column="0" Text="{Binding bookName}" FontSize="12" FontWeight="Bold" 
                                                   Foreground="#4A4A4A" HorizontalAlignment="Left" TextTrimming="CharacterEllipsis"/>

                                        <TextBlock Grid.Column="1" Text="{Binding price, StringFormat={}{0:F0} ₪}" FontSize="12" 
                                                   FontWeight="Bold" Foreground="#FF1493" HorizontalAlignment="Right" Margin="5,0,0,0"/>
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <Button Grid.Column="2" Content="▶" Width="30" Height="40" Background="Transparent" BorderThickness="0" 
                    Foreground="#FF1493" FontSize="16" Cursor="Hand" Click="ScrollRight_Click" VerticalAlignment="Center"/>
        </Grid>
    </StackPanel>
</UserControl>