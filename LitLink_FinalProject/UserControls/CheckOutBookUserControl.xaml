<UserControl x:Class="LitLink_FinalProject.UserControls.CheckOutBookUserControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:LitLink_FinalProject.UserControls"
             mc:Ignorable="d" 
             d:DesignHeight="90" d:DesignWidth="200">
    
    <Border Background="White" BorderBrush="#F0F0F0" BorderThickness="1" CornerRadius="10" Padding="8" Margin="0,0,15,5">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" CornerRadius="5" ClipToBounds="True" Margin="0,0,12,0" VerticalAlignment="Center">
                <Image x:Name="ImgBook" Width="50" Height="72" Stretch="UniformToFill"/>
            </Border>

            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock x:Name="TxtTitle" 
                           FontSize="14" 
                           FontWeight="SemiBold" 
                           Foreground="#333333" 
                           TextTrimming="CharacterEllipsis"
                           Margin="0,0,0,6"/>
                <TextBlock x:Name="TxtPrice" 
                           FontSize="13" 
                           FontWeight="Bold" 
                           Foreground="#333333"/>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
