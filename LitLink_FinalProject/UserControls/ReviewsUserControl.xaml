<UserControl x:Class="LitLink_FinalProject.UserControls.ReviewsUserControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:LitLink_FinalProject.UserControls"
             mc:Ignorable="d" 
            d:DesignHeight="200" d:DesignWidth="500">

    <UserControl.Resources>
        <Style x:Key="MiniPinkButton" TargetType="Button">
            <Setter Property="Background" Value="#FF1493"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="10,2"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="5">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Border Background="#FFF0F5" CornerRadius="15" Margin="5" Padding="15">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="65"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Button x:Name="CommentMenuBtn" 
                    Content="⋮" 
                    FontSize="22" 
                    Background="Transparent" 
                    BorderThickness="0" 
                    Foreground="#D06A8D" 
                    Cursor="Hand" 
                    Grid.Column="1" 
                    HorizontalAlignment="Right" 
                    VerticalAlignment="Top" 
                    Panel.ZIndex="10"
                    Margin="0,0,5,0"
                    Click="CommentMenuBtn_Click">
                <Button.ContextMenu>
                    <ContextMenu x:Name="CommentContextMenu">

                        <MenuItem Header="Delete My Comment" x:Name="DeleteOwnItem" Click="DeleteComment_Click" Foreground="Red"/>

                        <MenuItem Header="Report Comment" x:Name="ReportItem" Click="ReportComment_Click"/>

                        <MenuItem Header="Delete (Admin)" x:Name="AdminDeleteItem" Click="DeleteComment_Click" Foreground="Red"/>
                        <MenuItem Header="Remove Report (Admin)" x:Name="RemoveReportItem" Click="RemoveReport_Click"/>
                    </ContextMenu>
                </Button.ContextMenu>
            </Button>

            <Border Grid.Column="0" Width="50" Height="50" CornerRadius="25" 
                    BorderBrush="#FFC0CB" BorderThickness="2" Background="Transparent" VerticalAlignment="Top" ClipToBounds="True">
                <Image x:Name="ReaderProfileImage" Stretch="UniformToFill"/>
            </Border>

            <StackPanel Grid.Column="1" Margin="12,0,35,0">
                <TextBlock Text="{Binding IdReader.Nickname}" 
                           FontWeight="Bold" FontSize="15" Foreground="#4A4A4A"/>

                <TextBlock Text="{Binding Stars, StringFormat='{}{0} ★'}" Foreground="#FFD700" FontSize="14" Margin="0,2,0,5"/>

                <StackPanel x:Name="DisplayArea" Visibility="Visible">
                    <TextBlock x:Name="CommentTextBlock" 
                               Text="{Binding Text}" 
                               TextWrapping="Wrap" 
                               FontSize="14" 
                               Foreground="#333333" 
                               LineHeight="20"
                               MaxHeight="100"/>

                    <Button x:Name="ReadMoreBtn" 
                            Content="Read More" 
                            HorizontalAlignment="Left" 
                            Background="Transparent" 
                            BorderThickness="0" 
                            Foreground="#FF1493" 
                            FontWeight="Bold" 
                            Cursor="Hand" 
                            Margin="0,5,0,0"
                            Click="ReadMoreBtn_Click"/>
                </StackPanel>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>