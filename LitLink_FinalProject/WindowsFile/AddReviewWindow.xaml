<Window x:Class="LitLink_FinalProject.WindowsFile.AddReviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:LitLink_FinalProject.WindowsFile"
        mc:Ignorable="d"
        Title="Write a Review" Height="520" Width="460"
        WindowStartupLocation="CenterScreen" Background="#FFF5F7" ResizeMode="NoResize">

    <Window.Resources>
        <DropShadowEffect x:Key="SoftShadow" Color="#BCB3A4" BlurRadius="10"
                          Direction="270" ShadowDepth="2" Opacity="0.4"/>

        <Style x:Key="StarRadioStyle" TargetType="RadioButton">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <TextBlock x:Name="StarText"
                                   Text="☆" FontSize="34"
                                   Foreground="#D3D3D3"
                                   Cursor="Hand" Margin="3,0"/>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="StarText" Property="Text" Value="★"/>
                                <Setter TargetName="StarText" Property="Foreground" Value="#FFD700"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="StarText" Property="Foreground" Value="#FFD700"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="25">
        <Border Background="White" CornerRadius="15" Padding="20" Effect="{StaticResource SoftShadow}">
            <StackPanel>

                <TextBlock Text="Write a Review ✍️"
                           FontSize="22" FontWeight="Bold"
                           Foreground="#4A4A4A"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,4"/>

                <TextBlock x:Name="TxtBookLabel"
                           FontSize="13" Foreground="#D06A8D"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,20"/>

                <TextBlock Text="Your Rating"
                           FontSize="14" FontWeight="SemiBold"
                           Foreground="#4A4A4A" Margin="0,0,0,8"/>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,0,0,18">
                    <RadioButton x:Name="Star1" GroupName="Stars" Tag="1" Style="{StaticResource StarRadioStyle}"/>
                    <RadioButton x:Name="Star2" GroupName="Stars" Tag="2" Style="{StaticResource StarRadioStyle}"/>
                    <RadioButton x:Name="Star3" GroupName="Stars" Tag="3" Style="{StaticResource StarRadioStyle}" IsChecked="True"/>
                    <RadioButton x:Name="Star4" GroupName="Stars" Tag="4" Style="{StaticResource StarRadioStyle}"/>
                    <RadioButton x:Name="Star5" GroupName="Stars" Tag="5" Style="{StaticResource StarRadioStyle}"/>
                </StackPanel>

                <TextBlock Text="Your Review"
                           FontSize="14" FontWeight="SemiBold"
                           Foreground="#4A4A4A" Margin="0,0,0,5"/>

                <TextBox x:Name="TxtReviewContent"
                         Height="160" Padding="8,5"
                         AcceptsReturn="True" TextWrapping="Wrap"
                         VerticalScrollBarVisibility="Auto"
                         BorderBrush="#FFC0CB" BorderThickness="1.5"
                         Margin="0,0,0,25">
                    <TextBox.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="8"/>
                        </Style>
                    </TextBox.Resources>
                </TextBox>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="15"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Button Grid.Column="0" Content="Submit ✨"
                            Height="40" Background="#D06A8D"
                            Foreground="White" FontWeight="Bold"
                            Cursor="Hand" Click="BtnSubmit_Click">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="20"/>
                            </Style>
                        </Button.Resources>
                    </Button>

                    <Button Grid.Column="2" Content="Cancel"
                            Height="40" Background="Transparent"
                            BorderBrush="Gray" BorderThickness="1"
                            Foreground="Gray" Cursor="Hand"
                            Click="BtnCancel_Click">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="20"/>
                            </Style>
                        </Button.Resources>
                    </Button>
                </Grid>

            </StackPanel>
        </Border>
    </Grid>
</Window>
