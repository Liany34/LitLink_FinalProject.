<Window x:Class="LitLink_FinalProject.WindowsFile.AddBookToSeriesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Add Book to List" Height="350" Width="420"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
        Background="#E3DBCC">
    
    <StackPanel Margin="25">
        <TextBlock Text="Add Book to List" 
                   FontSize="18" 
                   FontWeight="Bold" 
                   Foreground="#D06A8D" 
                   Margin="0,0,0,15"/>
        <TextBlock Text="Select List:" 
                   FontSize="13" 
                   FontWeight="SemiBold" 
                   Margin="0,0,0,5"/>
        <ComboBox x:Name="CmbSeries" 
                  Height="32" 
                  DisplayMemberPath="NameSeries" 
                  Margin="0,0,0,12"/>
        <TextBlock Text="Select Book:" 
                   FontSize="13" 
                   FontWeight="SemiBold" 
                   Margin="0,0,0,5"/>
        <ComboBox x:Name="CmbBooks" 
                  Height="32" 
                  DisplayMemberPath="BookName" 
                  Margin="0,0,0,12"/>
        <TextBlock Text="Position in List:" 
                   FontSize="13" 
                   FontWeight="SemiBold" 
                   Margin="0,0,0,5"/>
        <TextBox x:Name="TxtNumber" 
                 Height="32" 
                 Padding="8,4" 
                 FontSize="14" 
                 Text="1"/>
        <StackPanel Orientation="Horizontal" 
                    HorizontalAlignment="Right" 
                    Margin="0,15,0,0">
            <Button Content="Cancel" 
                    Width="80" 
                    Height="32" 
                    Background="Transparent" 
                    BorderBrush="#D06A8D"
                    BorderThickness="1" 
                    Foreground="#D06A8D" 
                    Margin="0,0,10,0" 
                    Click="Cancel_Click" 
                    Cursor="Hand"/>
            <Button Content="Add" 
                    Width="80" 
                    Height="32" 
                    Background="#D06A8D" 
                    Foreground="White"
                    BorderThickness="0" 
                    FontWeight="Bold" 
                    Click="Add_Click" 
                    Cursor="Hand"/>
        </StackPanel>
    </StackPanel>
</Window>
