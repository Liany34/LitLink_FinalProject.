<Window x:Class="LitLink_FinalProject.WindowsFile.AddNewsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:LitLink_FinalProject.WindowsFile"
        mc:Ignorable="d"
        Title="Publish New Update" Height="520" Width="460" 
        WindowStartupLocation="CenterScreen" Background="#FFF5F7" ResizeMode="NoResize">

    <Window.Resources>
        <DropShadowEffect x:Key="SoftShadow" Color="#BCB3A4" BlurRadius="10" Direction="270" ShadowDepth="2" Opacity="0.4"/>
    </Window.Resources>

    <Grid Margin="25">
        <Border Background="White" CornerRadius="15" Padding="20" Effect="{StaticResource SoftShadow}">
            <StackPanel>
                <TextBlock Text="Publish New Update 📰" FontSize="22" FontWeight="Bold" Foreground="#4A4A4A" HorizontalAlignment="Center" Margin="0,0,0,5"/>
                <TextBlock x:Name="TxtAuthorLabel" Text="By: System Administrator" FontSize="13" Foreground="#D06A8D" HorizontalAlignment="Center" Margin="0,0,0,20"/>

                <TextBlock Text="News Title" FontSize="14" FontWeight="SemiBold" Foreground="#4A4A4A" Margin="0,0,0,5"/>
                <TextBox x:Name="TxtNewsTitle" Height="35" Padding="8,5" BorderBrush="#FFC0CB" BorderThickness="1.5" Margin="0,0,0,15">
                    <TextBox.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="8"/>
                        </Style>
                    </TextBox.Resources>
                </TextBox>

                <TextBlock Text="Message Content" FontSize="14" FontWeight="SemiBold" Foreground="#4A4A4A" Margin="0,0,0,5"/>
                <TextBox x:Name="TxtNewsContent" Height="140" Padding="8,5" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" BorderBrush="#FFC0CB" BorderThickness="1.5" Margin="0,0,0,25">
                    <TextBox.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="8"/>
                        </Style>
                    </TextBox.Resources>
                </TextBox>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="15"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Button Grid.Column="0" Content="Publish ✨" Height="40" Background="#D06A8D" Foreground="White" FontWeight="Bold" Cursor="Hand" Click="BtnPublish_Click">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="20"/>
                            </Style>
                        </Button.Resources>
                    </Button>

                    <Button Grid.Column="2" Content="Cancel" Height="40" Background="Transparent" BorderBrush="Gray" BorderThickness="1" Foreground="Gray" Cursor="Hand" Click="BtnCancel_Click">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="20"/>
                            </Style>
                        </Button.Resources>
                    </Button>
                </Grid>
            </StackPanel>
        </Border>
    </Grid>
</Window>