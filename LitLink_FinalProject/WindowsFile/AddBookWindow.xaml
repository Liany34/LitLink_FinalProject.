<Window x:Class="LitLink_FinalProject.WindowsFile.AddBookWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:LitLink_FinalProject.WindowsFile"
        mc:Ignorable="d"
        Title="AddBookWindow" Height="680" Width="480" 
        WindowStartupLocation="CenterScreen" Background="#FFF5F7" ResizeMode="NoResize">

    <Window.Resources>
        <DropShadowEffect x:Key="SoftShadow" Color="#BCB3A4" BlurRadius="10" Direction="270" ShadowDepth="2" Opacity="0.4"/>
    </Window.Resources>

    <Grid Margin="20">
        <Border Background="White" CornerRadius="15" Padding="20" Effect="{StaticResource SoftShadow}">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Text="Publish a New Book 📚" FontSize="22" FontWeight="Bold" Foreground="#4A4A4A" HorizontalAlignment="Center" Margin="0,0,0,15"/>

                    <TextBlock Text="Book Title" FontSize="13" FontWeight="SemiBold" Foreground="#4A4A4A" Margin="0,0,0,5"/>
                    <TextBox x:Name="TxtBookName" Height="30" Padding="5,2" BorderBrush="#FFC0CB" BorderThickness="1.5" Margin="0,0,0,12"/>

                    <TextBlock Text="Cover Image URL / Path" FontSize="13" FontWeight="SemiBold" Foreground="#4A4A4A" Margin="0,0,0,5"/>
                    <TextBox x:Name="TxtCoverUrl" Height="30" Padding="5,2" BorderBrush="#FFC0CB" BorderThickness="1.5" Margin="0,0,0,12"/>

                    <TextBlock Text="Book Summary / Description" FontSize="13" FontWeight="SemiBold" Foreground="#4A4A4A" Margin="0,0,0,5"/>
                    <TextBox x:Name="TxtDescription" Height="70" Padding="5" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" BorderBrush="#FFC0CB" BorderThickness="1.5" Margin="0,0,0,12"/>

                    <TextBlock Text="Digital Book Link (URL)" FontSize="13" FontWeight="SemiBold" Foreground="#4A4A4A" Margin="0,0,0,5"/>
                    <TextBox x:Name="TxtBookLink" Height="30" Padding="5,2" BorderBrush="#FFC0CB" BorderThickness="1.5" Margin="0,0,0,12"/>

                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="15"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Price (₪)" FontSize="13" FontWeight="SemiBold" Foreground="#4A4A4A" Margin="0,0,0,5"/>
                            <TextBox x:Name="TxtPrice" Height="30" Padding="5,2" BorderBrush="#FFC0CB" BorderThickness="1.5"/>
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Publication Date" FontSize="13" FontWeight="SemiBold" Foreground="#4A4A4A" Margin="0,0,0,5"/>
                            <DatePicker x:Name="DpPublishDate" Height="30" BorderBrush="#FFC0CB" BorderThickness="1.5"/>
                        </StackPanel>
                    </Grid>

                    <TextBlock Text="Book Language" FontSize="13" FontWeight="SemiBold" Foreground="#4A4A4A" Margin="0,0,0,5"/>
                    <ComboBox x:Name="CmbLanguages" Height="30" BorderBrush="#FFC0CB" BorderThickness="1.5" DisplayMemberPath="Name" Margin="0,0,0,12"/>

                    <TextBlock Text="Select Genres / Categories (Multiple)" FontSize="13" FontWeight="SemiBold" Foreground="#4A4A4A" Margin="0,0,0,5"/>
                    <Border BorderBrush="#FFC0CB" BorderThickness="1.5" CornerRadius="5" Padding="5" Margin="0,0,0,20">
                        <ListBox x:Name="LstCategories" Height="90" BorderThickness="0" Background="Transparent">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <CheckBox Content="{Binding GenreData.Name}" IsChecked="{Binding IsSelected}" Margin="0,2"/>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Border>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="15"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Button Grid.Column="0" Content="Publish Book ✨" Height="38" Background="#D06A8D" Foreground="White" FontWeight="Bold" Cursor="Hand" Click="BtnPublish_Click"/>
                        <Button Grid.Column="2" Content="Cancel" Height="38" Background="Transparent" BorderBrush="Gray" BorderThickness="1" Foreground="Gray" Cursor="Hand" Click="BtnCancel_Click"/>
                    </Grid>
                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</Window>
