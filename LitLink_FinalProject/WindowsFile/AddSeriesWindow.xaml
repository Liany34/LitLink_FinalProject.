<Window x:Class="LitLink_FinalProject.WindowsFile.AddSeriesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="New Book List" Height="220" Width="400"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="#E3DBCC">
    
    <StackPanel Margin="25">
        <TextBlock Text="Create New Book List" FontSize="18" FontWeight="Bold" Foreground="#D06A8D" Margin="0,0,0,15"/>
        <TextBlock Text="List Name:" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,5"/>
        <TextBox x:Name="TxtSeriesName" Height="32" Padding="8,4" FontSize="14"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button Content="Cancel" Width="80" Height="32" Background="Transparent" BorderBrush="#D06A8D"
                    BorderThickness="1" Foreground="#D06A8D" Margin="0,0,10,0" Click="Cancel_Click" Cursor="Hand"/>
            <Button Content="Create" Width="80" Height="32" Background="#D06A8D" Foreground="White"
                    BorderThickness="0" FontWeight="Bold" Click="Create_Click" Cursor="Hand"/>
        </StackPanel>
    </StackPanel>
</Window>
