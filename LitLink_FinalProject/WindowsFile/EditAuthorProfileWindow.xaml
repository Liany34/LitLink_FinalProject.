<Window x:Class="LitLink_FinalProject.WindowsFile.EditAuthorProfileWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:LitLink_FinalProject.WindowsFile"
        mc:Ignorable="d"
        Title="EditAuthorProfileWindow"
        Height="400" Width="400" 
        WindowStartupLocation="CenterScreen" Background="#FFF5F7" ResizeMode="NoResize">

    <Grid Margin="25">
        <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,10,0,-10">
            <StackPanel>
                <TextBlock Text="Edit Author &amp; User Details 🌸" FontSize="20" FontWeight="Bold" Foreground="#4A4A4A" HorizontalAlignment="Center" Margin="0,0,0,20"/>

                <TextBlock Text="Pen Name (Public Author Name):" FontSize="14" FontWeight="Bold" Foreground="#D06A8D" Margin="0,0,0,5"/>
                <TextBox x:Name="TxtEditPenName" Height="35" Padding="5" BorderBrush="#D06A8D" BorderThickness="1.5" Margin="0,0,0,12"/>

                <TextBlock Text="About You (Bio):" FontSize="14" FontWeight="Bold" Foreground="#D06A8D" Margin="0,0,0,5"/>
                <TextBox x:Name="TxtEditBio" Height="80" Padding="5" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" BorderBrush="#D06A8D" BorderThickness="1.5" Margin="0,0,0,15"/>

                <Rectangle Height="1" Fill="#BCB3A4" Margin="0,5,0,15"/>

                <TextBlock Text="Username:" FontSize="14" FontWeight="SemiBold" Foreground="#4A4A4A" Margin="0,0,0,5"/>
                <TextBox x:Name="TxtEditUsername" Height="35" Padding="5" BorderBrush="#FFC0CB" BorderThickness="1.5" Margin="0,0,0,12"/>

                <TextBlock Text="Nickname:" FontSize="14" FontWeight="SemiBold" Foreground="#4A4A4A" Margin="0,0,0,5"/>
                <TextBox x:Name="TxtEditNickname" Height="35" Padding="5" BorderBrush="#FFC0CB" BorderThickness="1.5" Margin="0,0,0,12"/>

                <TextBlock Text="First Name:" FontSize="14" FontWeight="SemiBold" Foreground="#4A4A4A" Margin="0,0,0,5"/>
                <TextBox x:Name="TxtEditFirstName" Height="35" Padding="5" BorderBrush="#FFC0CB" BorderThickness="1.5" Margin="0,0,0,12"/>

                <TextBlock Text="Last Name:" FontSize="14" FontWeight="SemiBold" Foreground="#4A4A4A" Margin="0,0,0,5"/>
                <TextBox x:Name="TxtEditLastName" Height="35" Padding="5" BorderBrush="#FFC0CB" BorderThickness="1.5" Margin="0,0,0,12"/>

                <TextBlock Text="Phone Number:" FontSize="14" FontWeight="SemiBold" Foreground="#4A4A4A" Margin="0,0,0,5"/>
                <TextBox x:Name="TxtEditPhone" Height="35" Padding="5" BorderBrush="#FFC0CB" BorderThickness="1.5" Margin="0,0,0,12"/>

                <TextBlock Text="Email Address:" FontSize="14" FontWeight="SemiBold" Foreground="#4A4A4A" Margin="0,0,0,5"/>
                <TextBox x:Name="TxtEditEmail" Height="35" Padding="5" BorderBrush="#FFC0CB" BorderThickness="1.5" Margin="0,0,0,12"/>

                <TextBlock Text="Profile Image URL:" FontSize="14" FontWeight="SemiBold" Foreground="#4A4A4A" Margin="0,0,0,5"/>
                <TextBox x:Name="TxtEditImgUrl" Height="35" Padding="5" BorderBrush="#FFC0CB" BorderThickness="1.5" Margin="0,0,0,25"/>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="15"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Button Grid.Column="0" Content="Save All Changes" Height="35" Background="#D06A8D" Foreground="White" FontWeight="Bold" Click="BtnSave_Click"/>
                    <Button Grid.Column="2" Content="Cancel" Height="35" Background="Transparent" BorderBrush="Gray" BorderThickness="1" Foreground="Gray" Click="BtnCancel_Click"/>
                </Grid>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
