<Page x:Class="LitLink_FinalProject.Pages.AdminProfile"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:LitLink_FinalProject.Pages"
      xmlns:uc="clr-namespace:LitLink_FinalProject.UserControls"
      mc:Ignorable="d" 
      Height="750" Width="900" 
      Background="#E3DBCC"
      Title="AdminProfile">

    <Page.Resources>
        <DropShadowEffect x:Key="AdminShadow" Color="#BCB3A4" BlurRadius="10" Direction="270" ShadowDepth="2" Opacity="0.5"/>
    </Page.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,15">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" HorizontalAlignment="Center">
                <Border Width="100" Height="100" CornerRadius="50" ClipToBounds="True" BorderBrush="#FFC0CB" BorderThickness="2">
                    <Image x:Name="ImgAdminProfile" Stretch="UniformToFill"/>
                </Border>
            </StackPanel>

            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="20,0,0,0">
                <TextBlock x:Name="TxtHelloAdmin" Text="Hello, AdminName" FontSize="28" FontWeight="Bold" Foreground="#4A4A4A"/>
                <TextBlock Text="System Administrator Mode 👑" FontSize="13" Foreground="#D06A8D" Margin="2,4,0,0"/>
            </StackPanel>

            <Button Grid.Column="2" Content="☰" FontSize="26" Background="Transparent" BorderThickness="0" Foreground="#4A4A4A" Cursor="Hand" VerticalAlignment="Top" Margin="0,10,10,0" Click="BtnMenu_Click"/>
        </Grid>

        <Rectangle Grid.Row="1" Height="1" Fill="#BCB3A4" Margin="0,5,0,15"/>

        <Grid Grid.Row="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <UniformGrid Grid.Row="0" Columns="3" Margin="0,0,0,15">
                <Button x:Name="BtnTabSales" Content="Sales Data" FontSize="16" FontWeight="Bold" Background="Transparent" BorderThickness="0" Foreground="#4A4A4A" Click="TabSales_Click"/>
                <Button x:Name="BtnTabReports" Content="Reports" FontSize="16" FontWeight="Bold" Background="Transparent" BorderThickness="0" Foreground="#999999" Click="TabReports_Click"/>
                <Button x:Name="BtnTabDiscounts" Content="Discount Codes" FontSize="16" FontWeight="Bold" Background="Transparent" BorderThickness="0" Foreground="#999999" Click="TabDiscounts_Click" Height="23" VerticalAlignment="Top"/>
            </UniformGrid>

            <Grid Grid.Row="1">
                <ScrollViewer x:Name="PanelSales" Visibility="Visible" VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <Border Background="White" CornerRadius="12" Padding="20" Effect="{StaticResource AdminShadow}" Margin="0,5,10,15">
                            <StackPanel>
                                <TextBlock Text="🌐 Platform Wide Financial Overview" FontSize="18" FontWeight="Bold" Foreground="#4A4A4A" Margin="0,0,0,15"/>
                                <UniformGrid Columns="2">
                                    <StackPanel Margin="10">
                                        <TextBlock Text="Total Books Sold (All Platform)" FontSize="13" Foreground="Gray"/>
                                        <TextBlock x:Name="TxtGlobalSales" Text="0" FontSize="26" FontWeight="Bold" Foreground="#D06A8D"/>
                                    </StackPanel>
                                    <StackPanel Margin="10">
                                        <TextBlock Text="Total Global Revenue" FontSize="13" Foreground="Gray"/>
                                        <TextBlock x:Name="TxtGlobalRevenue" Text="0 ₪" FontSize="26" FontWeight="Bold" Foreground="#2ECC71"/>
                                    </StackPanel>
                                </UniformGrid>
                            </StackPanel>
                        </Border>

                        <TextBlock Text="View Sales by Author" FontSize="16" FontWeight="Bold" Foreground="#4A4A4A" Margin="5,10,0,8"/>
                        <ComboBox x:Name="CmbAuthors" Height="35" Width="250" HorizontalAlignment="Left" Margin="5,0,0,15" DisplayMemberPath="PenName" SelectionChanged="CmbAuthors_SelectionChanged" Panel.ZIndex="99"/>

                        <Border x:Name="AuthorSalesResultCard" Background="White" CornerRadius="12" Padding="20" Margin="0,0,10,10" Visibility="Collapsed" Effect="{StaticResource AdminShadow}">
                            <StackPanel>
                                <TextBlock x:Name="TxtSelectedAuthorTitle" Text="Author Sales Data" FontSize="16" FontWeight="Bold" Foreground="#D06A8D" Margin="0,0,0,10"/>
                                <UniformGrid Columns="2">
                                    <TextBlock x:Name="TxtAuthorSoldCopies" Text="Copies Sold: 0" FontSize="14" Foreground="#4A4A4A"/>
                                    <TextBlock x:Name="TxtAuthorRevenue" Text="Revenue: 0 ₪" FontSize="14" FontWeight="Bold" Foreground="#2ECC71"/>
                                </UniformGrid>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <ScrollViewer x:Name="PanelReports" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="ReportsContainer" Margin="0,5,10,10"/>
                </ScrollViewer>

                <Grid x:Name="PanelDiscounts" Visibility="Collapsed" Margin="0,5,10,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="3*"/>
                        <ColumnDefinition Width="2*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Background="White" CornerRadius="12" Padding="15" Margin="0,0,15,0" Effect="{StaticResource AdminShadow}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Text="Active Discount Coupons" FontSize="16" FontWeight="Bold" Foreground="#4A4A4A" Margin="0,0,0,10"/>
                            <ListView Grid.Row="1" x:Name="LvwCoupons" Background="Transparent" BorderThickness="0">
                                <ListView.View>
                                    <GridView>
                                        <GridViewColumn Header="Code" DisplayMemberBinding="{Binding CodeText}" Width="100"/>
                                        <GridViewColumn Header="Discount (₪)" DisplayMemberBinding="{Binding Amount}" Width="80"/>

                                        <GridViewColumn Header="Valid Until" DisplayMemberBinding="{Binding ValidUntil, StringFormat=\{0:dd/MM/yyyy\}}" Width="95"/>

                                        <GridViewColumn Header="Status" Width="80">
                                            <GridViewColumn.CellTemplate>
                                                <DataTemplate>
                                                    <TextBlock x:Name="TxtStatus" FontWeight="Bold"/>
                                                    <DataTemplate.Triggers>
                                                        <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                            <Setter TargetName="TxtStatus" Property="Text" Value="Active 🟢"/>
                                                            <Setter TargetName="TxtStatus" Property="Foreground" Value="Green"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding IsActive}" Value="False">
                                                            <Setter TargetName="TxtStatus" Property="Text" Value="Inactive 🔴"/>
                                                            <Setter TargetName="TxtStatus" Property="Foreground" Value="Red"/>
                                                        </DataTrigger>
                                                    </DataTemplate.Triggers>
                                                </DataTemplate>
                                            </GridViewColumn.CellTemplate>
                                        </GridViewColumn>

                                        <GridViewColumn Header="Actions" Width="80">
                                            <GridViewColumn.CellTemplate>
                                                <DataTemplate>
                                                    <Button Content="Delete" Foreground="Red" Background="Transparent" BorderThickness="0" Cursor="Hand" Click="BtnDeleteCoupon_Click"/>
                                                </DataTemplate>
                                            </GridViewColumn.CellTemplate>
                                        </GridViewColumn>
                                    </GridView>
                                </ListView.View>
                            </ListView>
                        </Grid>
                    </Border>

                    <Border Grid.Column="1" Background="White" CornerRadius="12" Padding="20" Effect="{StaticResource AdminShadow}">
                        <StackPanel>
                            <TextBlock Text="Create New Coupon 🏷️" FontSize="16" FontWeight="Bold" Foreground="#D06A8D" Margin="0,0,0,15" HorizontalAlignment="Center"/>

                            <TextBlock Text="Coupon Code:" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,5"/>
                            <TextBox x:Name="TxtNewCouponCode" Height="30" Padding="5,2" Margin="0,0,0,12"/>

                            <TextBlock Text="Discount Amount (₪):" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,5"/>
                            <TextBox x:Name="TxtNewCouponAmount" Height="30" Padding="5,2" Margin="0,0,0,12"/>

                            <TextBlock Text="Valid Until:" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,5"/>
                            <DatePicker x:Name="DpValidUntil" Height="30" Margin="0,0,0,20"/>

                            <Button Content="Create &amp; Activate Code" Height="35" Background="#D06A8D" Foreground="White" FontWeight="Bold" Cursor="Hand" Click="BtnCreateCoupon_Click"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Grid>
        </Grid>

        <Grid x:Name="AdminMenuPopup" Grid.RowSpan="3" Background="#80000000" Visibility="Collapsed" MouseDown="OutsideMenu_MouseDown">
            <Border HorizontalAlignment="Right" Background="#FFF5F7" Width="260" Padding="20" Effect="{StaticResource AdminShadow}">
                <StackPanel>
                    <Grid Margin="0,0,0,25">
                        <TextBlock Text="Admin Menu" FontSize="18" FontWeight="Bold" Foreground="#4A4A4A" VerticalAlignment="Center"/>
                        <Button Content="✕" HorizontalAlignment="Right" Background="Transparent" BorderThickness="0" FontSize="16" Foreground="Gray" Cursor="Hand" Click="CloseMenu_Click"/>
                    </Grid>

                    <Button Content="📰 Add News Update" Background="White" HorizontalContentAlignment="Left" Padding="12,10" Margin="0,0,0,8" Cursor="Hand" Click="AddNews_Click"/>
                    <Button Content="🚪 Log Out" Background="Transparent" BorderThickness="0" Foreground="#D06A8D" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,20,0,0" Cursor="Hand" Click="LogOut_Click"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Page>
