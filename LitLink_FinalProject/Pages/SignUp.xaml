<Page x:Class="LitLink_FinalProject.Pages.SignUp"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:LitLink_FinalProject.Pages"
      mc:Ignorable="d" 
      Title="SignUp"
      Background="#f6dadd">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Image Grid.RowSpan="3"
               Source="/Covers/Flower.png"
               Width="90" Height="90"
               Opacity="0.9"
               HorizontalAlignment="Left"
               VerticalAlignment="Bottom"
               Panel.ZIndex="-1"
               Margin="10,0,0,90"
               Stretch="Uniform"/>
        <Image Grid.RowSpan="3"
               Source="/Covers/Flower.png"
               Width="120" Height="120"
               Opacity="0.9"
               HorizontalAlignment="Left"
               VerticalAlignment="Bottom"
               Panel.ZIndex="-1"
               Margin="60,0,0,10"
               Stretch="Uniform"/>

        <Button x:Name="BackButton"
                Content="← back"
                Grid.Row="0"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                Margin="20,20,0,0"
                Width="80"
                Height="35"
                Background="Transparent"
                Foreground="#6c3134"
                BorderThickness="0"
                Cursor="Hand"
                FontSize="16"
                FontFamily="/Fonts/Roboto Slab"
                Click="BackButton_Click"/>

        <StackPanel Grid.Row="0" HorizontalAlignment="Center" Margin="0,25,0,10">
            <TextBlock Text="Welcome to LitLink"
                       FontFamily="/Fonts/#Alex Brush"
                       FontSize="34"
                       Foreground="#aa3954"
                       HorizontalAlignment="Center"/>
            <Border BorderBrush="#aa3954" BorderThickness="0,1,0,0" Width="340" Margin="0,8,0,0"/>
        </StackPanel>

        <Grid Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,20,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="330"/>
                <ColumnDefinition Width="330"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Margin="10,0,30,0">

                <StackPanel Margin="0,0,0,22">
                    <TextBox x:Name="FirstNameInput"
                             Height="30"
                             Text="Please enter your First Name"
                             Foreground="#aa3954"
                             FontSize="15"
                             FontFamily="/Fonts/#Alex Brush"
                             Background="Transparent"
                             BorderThickness="0,0,0,1"
                             BorderBrush="#aa3954"
                             VerticalContentAlignment="Center"
                             GotFocus="FirstNameInput_GotFocus"
                             LostFocus="FirstNameInput_LostFocus"/>
                    <TextBlock x:Name="ExistingNameWarning"
                               Text="First name is required"
                               Foreground="#aa3954"
                               FontSize="10"
                               Visibility="Collapsed"
                               FontFamily="/Fonts/#Roboto Slab"
                               Margin="2,3,0,0"/>
                </StackPanel>

                <StackPanel Margin="0,0,0,22">
                    <TextBox x:Name="LastNameInput"
                             Height="30"
                             Text="Please enter your LastName"
                             Foreground="#aa3954"
                             FontSize="15"
                             FontFamily="/Fonts/#Alex Brush"
                             Background="Transparent"
                             BorderThickness="0,0,0,1"
                             BorderBrush="#aa3954"
                             VerticalContentAlignment="Center"
                             GotFocus="LastNameInput_GotFocus"
                             LostFocus="LastNameInput_LostFocus"/>
                </StackPanel>

                <StackPanel Margin="0,0,0,22">
                    <StackPanel Margin="0,0,0,22">
                        <TextBox x:Name="EmailInput"
                             Height="30"
                             Text="Please enter your Email"
                             Foreground="#aa3954"
                             FontSize="15"
                             FontFamily="/Fonts/#Alex Brush"
                             Background="Transparent"
                             BorderThickness="0,0,0,1"
                             BorderBrush="#aa3954"
                             VerticalContentAlignment="Center"
                             GotFocus="EmailInput_GotFocus"
                             LostFocus="EmailInput_LostFocus"
                             TextChanged="EmailInput_TextChanged"/>
                        <TextBlock x:Name="InvalidEmail"
                               Text="Invalid email format"
                               Foreground="#c0392b"
                               FontSize="10"
                               Visibility="Collapsed"
                               FontFamily="/Fonts/#Roboto Slab"
                               Margin="2,3,0,0"/>
                        <TextBlock x:Name="ExistingEmail"
                               Text="Email already exists"
                               Foreground="#c0392b"
                               FontSize="10"
                               Visibility="Collapsed"
                               FontFamily="/Fonts/#Roboto Slab"
                               Margin="2,3,0,0"/>
                    </StackPanel>
                </StackPanel>

                <StackPanel Margin="0,0,0,22">
                    <TextBox x:Name="PhoneInput"
                             Height="30"
                             Text="Please enter your Phone Number"
                             Foreground="#aa3954"
                             FontSize="15"
                             FontFamily="/Fonts/#Alex Brush"
                             Background="Transparent"
                             BorderThickness="0,0,0,1"
                             BorderBrush="#aa3954"
                             VerticalContentAlignment="Center"
                             GotFocus="PhoneInput_GotFocus"
                             LostFocus="PhoneInput_LostFocus"/>
                    <TextBlock x:Name="InvaildPhone"
                               Text="Invalid phone Number"
                               Foreground="#c0392b"
                               FontSize="10"
                               Visibility="Collapsed"
                               FontFamily="/Fonts/#Roboto Slab"
                               Margin="2,3,0,0"/>
                    <TextBlock x:Name="ExistingPhone"
                               Text="Phone number already exists"
                               Foreground="#c0392b"
                               FontSize="10"
                               Visibility="Collapsed"
                               FontFamily="/Fonts/#Roboto Slab"
                               Margin="2,3,0,0"/>
                </StackPanel>

                <Grid Margin="0,0,0,22">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="30"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0">
                        <PasswordBox x:Name="PasswordInput"
                                     Background="Transparent"
                                     BorderThickness="0,0,0,1"
                                     BorderBrush="#aa3954"
                                     Foreground="#aa3954"
                                     FontFamily="/Fonts/Alex Brush"
                                     FontSize="15"
                                     VerticalContentAlignment="Center"
                                     GotFocus="PasswordInput_GotFocus"
                                     LostFocus="PasswordInput_LostFocus"
                                     PasswordChanged="PasswordInput_PasswordChanged"/>
                        <TextBox x:Name="VisiblePasswordInput"
                                 Visibility="Collapsed"
                                 Background="Transparent"
                                 BorderThickness="0,0,0,1"
                                 BorderBrush="#aa3954"
                                 Foreground="#aa3954"
                                 FontFamily="/Fonts/Roboto Slab"
                                 FontSize="15"
                                 VerticalContentAlignment="Center"/>
                        <TextBlock x:Name="PasswordPlaceholder"
                                   Text="Please enter your Password"
                                   Foreground="#aa3954"
                                   FontSize="15"
                                   FontFamily="/Fonts/#Alex Brush"
                                   VerticalAlignment="Center"
                                   IsHitTestVisible="False"/>
                        <Button x:Name="TogglePasswordButton"
                                Content="👁"
                                HorizontalAlignment="Right"
                                Background="Transparent"
                                BorderThickness="0"
                                Cursor="Hand"
                                Opacity="0.5"
                                Margin="0,0,5,0"
                                PreviewMouseDown="TogglePasswordButton_PreviewMouseDown"
                                PreviewMouseUp="TogglePasswordButton_PreviewMouseUp"/>
                    </Grid>

                    <TextBlock x:Name="WeakPassword"
                               Grid.Row="1"
                               Text="Password must be at least 6 characters"
                               Foreground="#c0392b"
                               FontSize="10"
                               Visibility="Collapsed"
                               FontFamily="/Fonts/#Roboto Slab"
                               Margin="2,3,0,0"/>
                </Grid>

                <Grid Margin="0,0,0,10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="30"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0">
                        <PasswordBox x:Name="ReenterInput"
                                     Background="Transparent"
                                     BorderThickness="0,0,0,1"
                                     BorderBrush="#aa3954"
                                     Foreground="#aa3954"
                                     FontFamily="/Fonts/#Alex Brush"
                                     FontSize="15"
                                     VerticalContentAlignment="Center"
                                     GotFocus="ReenterInput_GotFocus"
                                     LostFocus="ReenterInput_LostFocus"
                                     PasswordChanged="ReenterInput_PasswordChanged"/>
                        <TextBox x:Name="VisibleReenterInput"
                                 Visibility="Collapsed"
                                 Background="Transparent"
                                 BorderThickness="0,0,0,1"
                                 BorderBrush="#aa3954"
                                 Foreground="#aa3954"
                                 FontFamily="/Fonts/Roboto Slab"
                                 FontSize="15"
                                 VerticalContentAlignment="Center"/>
                        <TextBlock x:Name="ReenterPlaceholder"
                                   Text="Please confirm your Password"
                                   Foreground="#aa3954"
                                   FontSize="15"
                                   FontFamily="/Fonts/#Alex Brush"
                                   VerticalAlignment="Center"
                                   IsHitTestVisible="False"/>
                        <Button x:Name="ToggleReenterButton"
                                Content="👁"
                                HorizontalAlignment="Right"
                                Background="Transparent"
                                BorderThickness="0"
                                Cursor="Hand"
                                Opacity="0.5"
                                Margin="0,0,5,0"
                                PreviewMouseDown="ToggleReenterButton_PreviewMouseDown"
                                PreviewMouseUp="ToggleReenterButton_PreviewMouseUp"/>
                    </Grid>

                    <TextBlock x:Name="DiffPass"
                               Grid.Row="1"
                               Text="Passwords do not match"
                               FontFamily="/Fonts/#Roboto Slab"
                               FontSize="10"
                               Foreground="#c0392b"
                               Visibility="Collapsed"
                               Margin="2,3,0,0"/>
                </Grid>
            </StackPanel>

            <StackPanel Grid.Column="1" Margin="30,0,10,0">

                <StackPanel Margin="0,0,0,22">
                    <TextBlock Text="Please enter your Date of Birth"
                               Foreground="#aa3954"
                               FontSize="15"
                               FontFamily="/Fonts/#Alex Brush"
                               TextWrapping="Wrap"
                               Margin="0,0,0,4"/>
                    <DatePicker x:Name="BirthDatePicker"
                                Height="26"
                                Foreground="#aa3954"
                                FontSize="13"
                                FontFamily="/Fonts/#Alex Brush"
                                Background="Transparent"
                                BorderThickness="0,0,0,1"
                                BorderBrush="#aa3954"/>
                    <TextBlock x:Name="InvalidBirthDate"
                               Text="You must choose your birthdate"
                               Foreground="#c0392b"
                               FontSize="10"
                               Visibility="Collapsed"
                               FontFamily="/Fonts/#Roboto Slab"
                               Margin="2,3,0,0"/>
                </StackPanel>

                <Border Height="120"/>

                <StackPanel Margin="0,0,0,22">
                    <TextBox x:Name="NicknameInput"
                             Height="30"
                             Text="Please enter your Nickname"
                             Foreground="#aa3954"
                             FontSize="15"
                             FontFamily="/Fonts/#Alex Brush"
                             Background="Transparent"
                             BorderThickness="0,0,0,1"
                             BorderBrush="#aa3954"
                             VerticalContentAlignment="Center"
                             GotFocus="NicknameInput_GotFocus"
                             LostFocus="NicknameInput_LostFocus"/>
                </StackPanel>

                <StackPanel Margin="0,0,0,22">
                    <TextBox x:Name="UsernameInput"
                             Height="30"
                             Text="Please enter your Username"
                             Foreground="#aa3954"
                             FontSize="15"
                             FontFamily="/Fonts/#Alex Brush"
                             Background="Transparent"
                             BorderThickness="0,0,0,1"
                             BorderBrush="#aa3954"
                             VerticalContentAlignment="Center"
                             GotFocus="UsernameInput_GotFocus"
                             LostFocus="UsernameInput_LostFocus"/>
                    <TextBlock x:Name="InvalidUsername"
                               Text="Username already exists"
                               Foreground="#c0392b"
                               FontSize="10"
                               Visibility="Collapsed"
                               FontFamily="/Fonts/#Roboto Slab"
                               Margin="2,3,0,0"/>
                </StackPanel>
            </StackPanel>
        </Grid>

        <Button x:Name="SignUpButton"
                Grid.Row="2"
                Content="Sign Up"
                Width="140"
                Height="42"
                HorizontalAlignment="Center"
                Margin="0,15,0,30"
                Background="#aa3954"
                Foreground="White"
                FontFamily="/Fonts/#Alex Brush"
                FontSize="20"
                BorderThickness="0"
                Cursor="Hand"
                Click="SignUpButton_Click"/>
    </Grid>
</Page>