<Page x:Class="LitLink_FinalProject.Pages.SearchResultsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:LitLink_FinalProject.Pages"
      xmlns:uc="clr-namespace:LitLink_FinalProject.UserControls"
      mc:Ignorable="d" 
      Height="700" Width="900"
      Background="#E3DBCC"
      Title="SearchResultsPage">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,20">
            <Button HorizontalAlignment="Left" Background="Transparent" BorderThickness="0" Cursor="Hand" Click="BackButton_Click">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="←" FontSize="18" Foreground="#D06A8D" VerticalAlignment="Center" Margin="0,0,5,0"/>
                    <TextBlock Text="Back to Home" FontSize="14" FontWeight="SemiBold" Foreground="#D06A8D" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
            <TextBlock x:Name="TxtSearchTitle" Text="Search Results for: ''" FontSize="24" FontWeight="Bold" Foreground="#4A4A4A" Margin="0,15,0,0"/>
        </StackPanel>

        <Grid Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock x:Name="TxtNoResults" Grid.Row="0" Text="No books or authors found matching your search." FontSize="16" Foreground="Gray" Margin="0,20,0,0" Visibility="Collapsed" HorizontalAlignment="Center"/>

            <StackPanel x:Name="BooksResultSection" Grid.Row="1" Visibility="Collapsed" Margin="0,0,0,30" Height="220">
                <TextBlock Text="Books Found" FontSize="20" FontWeight="Bold" Foreground="#D06A8D" Margin="5,0,0,15"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Button Grid.Column="0" Content="◀" Width="30" Height="40" Background="Transparent" BorderThickness="0" Foreground="#FF1493" FontSize="16" Click="ScrollBooksLeft_Click"/>

                    <ScrollViewer Grid.Column="1" x:Name="BooksScrollViewer" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled">
                        <ItemsControl x:Name="BooksItemsControl">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <uc:CatalogUserControl MouseDown="BookImage_MouseDown" Margin="0,0,15,5"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <Button Grid.Column="2" Content="▶" Width="30" Height="40" Background="Transparent" BorderThickness="0" Foreground="#FF1493" FontSize="16" Click="ScrollBooksRight_Click"/>
                </Grid>
            </StackPanel>

            <StackPanel x:Name="AuthorsResultSection" Grid.Row="2" Visibility="Collapsed" Margin="0,10,0,0" Height="240">
                <TextBlock Text="Authors Found" FontSize="20" FontWeight="Bold" Foreground="#D06A8D" Margin="5,0,0,15"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Button Grid.Column="0" Content="◀" Width="30" Height="40" Background="Transparent" BorderThickness="0" Foreground="#FF1493" FontSize="16" Click="ScrollAuthorsLeft_Click"/>

                    <ScrollViewer Grid.Column="1" x:Name="AuthorsScrollViewer" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled">
                        <ItemsControl x:Name="AuthorsItemsControl">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="White" BorderBrush="#FFC0CB" BorderThickness="1.5" CornerRadius="15" Padding="15" Margin="0,0,15,5" Width="150" Height="160" Cursor="Hand" MouseDown="AuthorCard_MouseDown">
                                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <Border Width="60" Height="60" CornerRadius="30" ClipToBounds="True" BorderBrush="#D06A8D" BorderThickness="1" HorizontalAlignment="Center" Margin="0,0,0,10">
                                                <Image Loaded="AuthorImage_Loaded" Stretch="UniformToFill"/>
                                            </Border>
                                            <TextBlock Text="{Binding PenName}" FontSize="14" FontWeight="Bold" Foreground="#4A4A4A" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <Button Grid.Column="2" Content="▶" Width="30" Height="40" Background="Transparent" BorderThickness="0" Foreground="#FF1493" FontSize="16" Click="ScrollAuthorsRight_Click"/>
                </Grid>
            </StackPanel>
        </Grid>
    </Grid>
</Page>