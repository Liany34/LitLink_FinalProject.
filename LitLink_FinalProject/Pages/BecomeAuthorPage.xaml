<Page x:Class="LitLink_FinalProject.Pages.BecomeAuthorPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:LitLink_FinalProject.Pages"
      mc:Ignorable="d" 
      Height="700" Width="900" 
      Background="#E3DBCC"
      Title="BecomeAuthorPage">

    <Page.Resources>
        <DropShadowEffect x:Key="GlobalDropShadow" Color="#BCB3A4" BlurRadius="15" Direction="270" ShadowDepth="3" Opacity="0.5"/>
    </Page.Resources>

    <Grid VerticalAlignment="Center" HorizontalAlignment="Center">
        <Border Background="White" CornerRadius="20" Padding="40" Width="450" Effect="{StaticResource GlobalDropShadow}">
            <StackPanel>
                <TextBlock Text="Become a LitLink Author" 
                           FontSize="26" 
                           FontWeight="Bold" 
                           Foreground="#4A4A4A" 
                           HorizontalAlignment="Center" 
                           Margin="0,0,0,5"/>
                <TextBlock Text="Share your stories with the world 🌸" 
                           FontSize="14" 
                           Foreground="#D06A8D" 
                           HorizontalAlignment="Center" 
                           Margin="0,0,0,25"/>

                <TextBlock Text="Pen Name" 
                           FontSize="14" 
                           FontWeight="SemiBold" 
                           Foreground="#4A4A4A" 
                           Margin="0,0,0,5"/>
                <TextBox x:Name="TxtPenName" 
                         Height="35"
                         Padding="8,5" 
                         BorderBrush="#FFC0CB" 
                         BorderThickness="1.5"
                         Margin="0,0,0,15">
                    <TextBox.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="8"/>
                        </Style>
                    </TextBox.Resources>
                </TextBox>

                <TextBlock Text="Primary Genre" 
                           FontSize="14" 
                           FontWeight="SemiBold"
                           Foreground="#4A4A4A" 
                           Margin="0,0,0,5"/>
                <ComboBox x:Name="CmbGenres" 
                          Height="35"
                          Padding="8,5"
                          BorderBrush="#FFC0CB" 
                          BorderThickness="1.5" 
                          Margin="0,0,0,15" 
                          DisplayMemberPath="Name">
                    <ComboBox.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="8"/>
                        </Style>
                    </ComboBox.Resources>
                </ComboBox>

                <TextBlock Text="About You (Information)"
                           FontSize="14" 
                           FontWeight="SemiBold" 
                           Foreground="#4A4A4A"
                           Margin="0,0,0,5"/>
                <TextBox x:Name="TxtBio" 
                         Height="100" 
                         Padding="8,5"
                         AcceptsReturn="True" 
                         TextWrapping="Wrap" 
                         VerticalScrollBarVisibility="Auto" 
                         BorderBrush="#FFC0CB"
                         BorderThickness="1.5" 
                         Margin="0,0,0,25">
                    <TextBox.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="8"/>
                        </Style>
                    </TextBox.Resources>
                </TextBox>

                <Button x:Name="BtnSubmit"
                        Content="Create Author Account ✨" 
                        Height="40" Background="#D06A8D"
                        Foreground="White" 
                        FontSize="16" 
                        FontWeight="Bold"
                        Cursor="Hand" 
                        Click="BtnSubmit_Click">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="20"/>
                        </Style>
                    </Button.Resources>
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Background" Value="#D06A8D"/>
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#FF1493"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>

                <Button Content="Cancel" 
                        Margin="0,10,0,0"
                        Background="Transparent" 
                        BorderThickness="0"
                        Foreground="Gray" 
                        HorizontalAlignment="Center"
                        Cursor="Hand" 
                        Click="Cancel_Click"/>
            </StackPanel>
        </Border>
    </Grid>
</Page>
